# CartGuard AI Environment Configuration
# Copy this to .env and fill in your keys

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq, openai, local
LLM_PROVIDER=groq

# Groq API (Free tier - get from https://console.groq.com)
# Gives access to Llama 3.2 for fast inference (~100ms)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (fallback for complex cases)
OPENAI_API_KEY=your_openai_api_key_here

# Local Llama via Ollama (run: ollama run llama3.2:3b)
LOCAL_LLM_URL=http://localhost:11434

# ─── Notifications ────────────────────────────────────────────────────────────
# SendGrid (100 free emails/day - https://sendgrid.com)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@cartguard.ai

# Twilio SMS/WhatsApp (free trial - https://twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./cartguard.db
# For production: postgresql://user:password@localhost/cartguard

# Redis (optional - for production WebSocket scaling)
REDIS_URL=redis://localhost:6379

# ─── Dashboard ────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
